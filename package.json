{
  "name": "anvil-vtt",
  "version": "0.1.0",
  "private": true,
  "description": "A Virtual Tabletop for Draw Steel that feels like directing a film",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "smoke:live": "node scripts/smoke-live-session.mjs --start-server",
    "smoke:live:api": "node scripts/smoke-live-session.mjs",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "build:server": "pnpm --filter @anvil/server build",
    "build:vtt": "pnpm --filter @anvil/vtt build",
    "deploy:check": "pnpm --filter @anvil/server build && pnpm --filter @anvil/vtt build",
    "deploy:server": "pnpm --filter @anvil/server deploy",
    "db:migrate:remote": "pnpm --filter @anvil/server db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.10.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.1.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
