{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": false,
    "isolatedModules": false
  },
  "include": ["src/**/*", "src/**/*.json"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/audit/**/*",
    "src/rules/classes/**/augmentations.ts",
    "src/rules/classes/**/colleges.ts",
    "src/rules/classes/**/doctrines.ts",
    "src/rules/classes/**/domains.ts",
    "src/rules/classes/**/elements.ts",
    "src/rules/classes/**/enhancements.ts",
    "src/rules/classes/**/features.ts",
    "src/rules/classes/**/growing-ferocity.ts",
    "src/rules/classes/**/index.ts",
    "src/rules/classes/**/orders.ts",
    "src/rules/classes/**/psi-boost.ts",
    "src/rules/classes/**/progression.ts",
    "src/rules/classes/**/routines.ts",
    "src/rules/classes/**/stormwight-kits.ts",
    "src/rules/classes/**/subclasses.ts",
    "src/rules/classes/**/traditions.ts",
    "src/rules/conditions.ts",
    "scripts/**/*"
  ],
  "references": [{ "path": "../types" }]
}
