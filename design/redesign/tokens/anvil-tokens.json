{
  "_source": "Storyboard, the direction chosen at Gate 1 (tokens/direction-c.json), extended at Gate 2 with the quiet rule, the hard-shadow colour and the art tokens. Edit here, then run: npm run tokens",
  "_rule": "Heavy ink carries meaning: the map frame, the active scene, whoever is acting, dying, the primary action, anything floating over the map. Everything inside a rail uses the quiet rule. Anything drawn on the map uses art tokens, so it reads the same in both themes and on any uploaded map.",
  "fonts": {
    "display": "\"Bricolage Grotesque Variable\", sans-serif",
    "body": "\"Atkinson Hyperlegible\", system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": { "min": "13px", "body": "14px", "name": "14px", "heading": "16px", "wordmark": "32px" },
  "shape": {
    "radius": "0",
    "frame": "3px",
    "frameQuiet": "1.5px",
    "hardShadow": "4px 4px 0",
    "hardShadowSmall": "3px 3px 0",
    "railLeft": "304px",
    "railRight": "294px"
  },
  "scene": {
    "story": "#8b3fe0",
    "montage": "#e38a00",
    "negotiation": "#2b6fe6",
    "battle": "#cf2a20",
